---
interface NavLink {
  label: string;
  href: string;
  external?: boolean;
}

interface Props {
  navLinks: NavLink[];
}

const { navLinks } = Astro.props;

const socialLinks = [
  { name: "Instagram", href: "#", handle: "@macheting" },
  { name: "LinkedIn", href: "#", handle: "Macheting" },
  { name: "TikTok", href: "#", handle: "@macheting" },
  { name: "YouTube", href: "#", handle: "Macheting" },
];
---

<footer class="bg-[#0d1225] border-t border-white/10">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10 py-16 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-16">
      <div>
        <a href="/">
          <img
            src="/logo-agenciamacheting.svg"
            alt="Macheting Logo"
            class="h-auto w-48 mb-6"
          />
        </a>
        <p class="text-white/40 text-sm leading-relaxed max-w-xs">
          Trabajamos con pequeñas y medianas empresas que buscan crecer con
          estrategia, creatividad y personas que realmente se involucren en su
          proyecto.
        </p>
      </div>

      <div>
        <h3
          class="text-xs font-bold uppercase tracking-[0.3em] text-brand-lime mb-6"
        >
          Navegar
        </h3>
        <ul class="flex flex-col gap-3">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                  class="text-white/50 hover:text-white text-sm font-medium uppercase tracking-widest transition-colors duration-200"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3
          class="text-xs font-bold uppercase tracking-[0.3em] text-brand-lime mb-6"
        >
          Redes
        </h3>
        <ul class="flex flex-col gap-3">
          {
            socialLinks.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 text-white/50 hover:text-brand-lime text-sm font-medium transition-colors duration-200 group"
                >
                  <span class="uppercase tracking-widest">{social.name}</span>
                  <span class="text-white/20 group-hover:text-brand-lime/40 text-xs">
                    ·
                  </span>
                  <span class="text-white/30 group-hover:text-brand-lime/60 text-xs">
                    {social.handle}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-white/5">
    <div
      class="max-w-[1400px] mx-auto px-6 lg:px-10 py-6 flex flex-col sm:flex-row items-center justify-between gap-4"
    >
      <p class="text-white/20 text-xs uppercase tracking-widest">
        &copy; {new Date().getFullYear()} Macheting. Todos los derechos reservados.
      </p>
      <div class="flex items-center gap-6">
        <a
          href="#"
          class="text-white/20 hover:text-white/50 text-xs uppercase tracking-widest transition-colors duration-200"
        >
          Aviso de privacidad
        </a>
        <a
          href="#"
          class="text-white/20 hover:text-white/50 text-xs uppercase tracking-widest transition-colors duration-200"
        >
          Términos de uso
        </a>
      </div>
    </div>
  </div>

  <div class="h-0.5 bg-brand-gold"></div>
</footer>

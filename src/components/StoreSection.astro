<section id="contacto" class="relative overflow-hidden">
  <div class="absolute inset-0">
    <img
      src="/images/dinamo.jpeg"
      alt="Macheting — Contacto"
      class="w-full h-full object-cover object-center"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-black/80"></div>
    <div class="absolute inset-0 bg-brand-primary/5"></div>
  </div>

  <div
    class="absolute top-8 left-8 w-12 h-12 border-t-2 border-l-2 border-brand-primary/40"
  >
  </div>
  <div
    class="absolute top-8 right-8 w-12 h-12 border-t-2 border-r-2 border-brand-primary/40"
  >
  </div>
  <div
    class="absolute bottom-8 left-8 w-12 h-12 border-b-2 border-l-2 border-brand-primary/40"
  >
  </div>
  <div
    class="absolute bottom-8 right-8 w-12 h-12 border-b-2 border-r-2 border-brand-primary/40"
  >
  </div>

  <div
    class="relative z-10 w-full max-w-[1400px] mx-auto px-6 lg:px-10 py-20 md:py-28"
  >
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-start">
      <div>
        <p
          class="text-xs font-bold uppercase tracking-[0.4em] text-brand-accent mb-4"
        >
          Sin obligación de contratar
        </p>
        <h2
          class="text-3xl md:text-4xl lg:text-5xl font-medium uppercase tracking-tighter text-white leading-tight mb-6"
        >
          Si llegaste hasta aquí, probablemente no estás buscando únicamente una agencia.
        </h2>
        <p
          class="text-base md:text-lg text-white/55 leading-relaxed mb-8 max-w-md"
        >
          Estás buscando personas que entiendan el esfuerzo que hay detrás de tu negocio.
        </p>
        <div class="flex flex-col gap-3">
          <div class="flex items-start gap-3">
            <div
              class="w-1.5 h-1.5 rounded-full bg-brand-primary mt-2 flex-shrink-0"
            >
            </div>
            <p class="text-white/40 text-sm">
              Nos encantará conocer tu proyecto, escuchar tus ideas y descubrir si somos el equipo indicado para acompañarte.
            </p>
          </div>
          <div class="flex items-start gap-3">
            <div
              class="w-1.5 h-1.5 rounded-full bg-brand-primary mt-2 flex-shrink-0"
            >
            </div>
            <p class="text-white/40 text-sm">
              Si después de conversar creemos que otra solución será mejor para ti, también te lo diremos.
            </p>
          </div>
          <div class="flex items-start gap-3">
            <div
              class="w-1.5 h-1.5 rounded-full bg-brand-primary mt-2 flex-shrink-0"
            >
            </div>
            <p class="text-white/40 text-sm">
              Porque la confianza siempre será más importante que cerrar una venta.
            </p>
          </div>
        </div>
      </div>

      <div
        class="bg-white/5 backdrop-blur-sm border border-white/10 p-8 md:p-10"
      >
        <form method="POST" action="#" class="flex flex-col gap-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="flex flex-col gap-2">
              <label
                class="text-[10px] font-bold uppercase tracking-[0.3em] text-white/40"
                >Nombre</label
              >
              <input
                type="text"
                name="nombre"
                required
                placeholder="Tu nombre"
                class="bg-white/5 border border-white/10 text-white placeholder:text-white/20 text-sm px-4 py-3 focus:outline-none focus:border-brand-primary/50 transition-colors duration-200"
              />
            </div>
            <div class="flex flex-col gap-2">
              <label
                class="text-[10px] font-bold uppercase tracking-[0.3em] text-white/40"
                >Empresa</label
              >
              <input
                type="text"
                name="empresa"
                placeholder="Nombre de tu empresa"
                class="bg-white/5 border border-white/10 text-white placeholder:text-white/20 text-sm px-4 py-3 focus:outline-none focus:border-brand-primary/50 transition-colors duration-200"
              />
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label
              class="text-[10px] font-bold uppercase tracking-[0.3em] text-white/40"
              >Presupuesto mensual (MXN)</label
            >
            <select
              name="presupuesto"
              class="bg-white/5 border border-white/10 text-white/70 text-sm px-4 py-3 focus:outline-none focus:border-brand-primary/50 transition-colors duration-200 appearance-none"
            >
              <option value="" disabled selected class="bg-[#14162e]"
                >Selecciona un rango</option
              >
              <option value="hasta-15k" class="bg-[#14162e]"
                >Hasta $15,000</option
              >
              <option value="15k-30k" class="bg-[#14162e]"
                >$15,000 – $30,000</option
              >
              <option value="30k-50k" class="bg-[#14162e]"
                >$30,000 – $50,000</option
              >
              <option value="mas-50k" class="bg-[#14162e]"
                >Más de $50,000</option
              >
            </select>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="flex flex-col gap-2">
              <label
                class="text-[10px] font-bold uppercase tracking-[0.3em] text-white/40"
                >Urgencia</label
              >
              <select
                name="urgencia"
                class="bg-white/5 border border-white/10 text-white/70 text-sm px-4 py-3 focus:outline-none focus:border-brand-primary/50 transition-colors duration-200 appearance-none"
              >
                <option value="" disabled selected class="bg-[#14162e]"
                  >¿Cuándo arrancan?</option
                >
                <option value="asap" class="bg-[#14162e]"
                  >Lo antes posible</option
                >
                <option value="1-2-semanas" class="bg-[#14162e]"
                  >En 1–2 semanas</option
                >
                <option value="1-mes" class="bg-[#14162e]"
                  >En aproximadamente 1 mes</option
                >
                <option value="explorando" class="bg-[#14162e]"
                  >Solo explorando opciones</option
                >
              </select>
            </div>
            <div class="flex flex-col gap-2">
              <label
                class="text-[10px] font-bold uppercase tracking-[0.3em] text-white/40"
                >Canal preferido</label
              >
              <select
                name="canal"
                class="bg-white/5 border border-white/10 text-white/70 text-sm px-4 py-3 focus:outline-none focus:border-brand-primary/50 transition-colors duration-200 appearance-none"
              >
                <option value="" disabled selected class="bg-[#14162e]"
                  >¿Cómo te contactamos?</option
                >
                <option value="whatsapp" class="bg-[#14162e]">WhatsApp</option>
                <option value="email" class="bg-[#14162e]">Email</option>
                <option value="telefono" class="bg-[#14162e]">Teléfono</option>
                <option value="videollamada" class="bg-[#14162e]"
                  >Videollamada</option
                >
              </select>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label
              class="text-[10px] font-bold uppercase tracking-[0.3em] text-white/40"
              >Cuéntanos más (opcional)</label
            >
            <textarea
              name="mensaje"
              rows="3"
              placeholder="¿Cuál es tu principal reto de marketing ahora mismo?"
              class="bg-white/5 border border-white/10 text-white placeholder:text-white/20 text-sm px-4 py-3 focus:outline-none focus:border-brand-primary/50 transition-colors duration-200 resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="group inline-flex items-center justify-center gap-3 bg-brand-accent text-black font-black uppercase text-sm tracking-widest px-6 py-4 hover:bg-white transition-colors duration-200 mt-1"
          >
            Hablemos de tu proyecto
            <svg
              class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="3"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </button>

          <p class="text-white/20 text-xs text-center">
            Sin obligación de contratar. Respondemos en menos de 24 horas.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

---
interface Package {
  number: string;
  name: string;
  tagline: string;
  price: string;
  features: string[];
  addon: string | null;
  featured: boolean;
}

const packages: Package[] = [
  {
    number: '01',
    name: 'Google Ads',
    tagline: 'Recomendado para empresas que quieren empezar a tener más clientes por Google.',
    price: '$7,790',
    features: [
      'Una campaña en Google con seguimiento diario y optimización semanal',
      'Sin límite de conjuntos de anuncios ni anuncios',
      'Landing page incluida: actualización mensual, responsiva, IA integrada',
      'Dashboard de prospectos + plan de seguimiento personalizado',
    ],
    addon: '¿Necesitas más alcance? Por $4,500 adicionales al mes puedes activar hasta 2 campañas más en Google.',
    featured: false,
  },
  {
    number: '02',
    name: 'Contenido + Meta Ads',
    tagline: 'Para marcas que necesitan presencia activa en redes con contenido y campañas orientadas a conversión real.',
    price: '$9,460',
    features: [
      'Contenido mensual personalizado en Meta',
      'Tres campañas en Meta: interacción, crecimiento y venta',
      'Copy y diseño de anuncios incluidos',
      'Segmentación por objetivo, seguimiento diario y optimización semanal',
      'Dashboard de prospectos + plan de seguimiento personalizado',
    ],
    addon: null,
    featured: false,
  }
];
---

<section id="paquetes" class="bg-[#14162e] py-20 md:py-28">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10">

    <div class="mb-10 md:mb-14">
      <p class="text-xs font-bold uppercase tracking-[0.3em] text-brand-accent mb-3">Paquetes</p>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-medium uppercase tracking-tighter text-white leading-tight max-w-4xl mb-6">
        Nuestros paquetes
      </h2>
      <p class="text-white/40 text-sm md:text-base leading-relaxed max-w-3xl mb-2">
        Queremos que sepas cuánto cuesta trabajar con nosotros antes de agendar una llamada.
      </p>
      <p class="text-white/40 text-sm md:text-base leading-relaxed max-w-3xl">
        Porque la transparencia no empieza cuando firmas un contrato. Empieza desde el momento en que llegas a nuestra página.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-white/5">
      {packages.map((pkg) => (
        <div
          class={`relative flex flex-col p-8 md:p-10 transition-colors duration-300 ${
            pkg.featured
              ? 'bg-white/[0.06] hover:bg-white/[0.08]'
              : 'bg-[#14162e] hover:bg-white/[0.03]'
          }`}
        >
          {pkg.featured && (
            <div class="absolute top-0 left-0 right-0 h-0.5 bg-brand-accent" />
          )}

          <div class="mb-6">
            <div class="flex items-center gap-3 mb-2">
              <span class="text-brand-accent/35 text-xs font-black uppercase tracking-widest">{pkg.number}</span>
              {pkg.featured && (
                <span class="bg-brand-accent text-black text-[10px] font-black uppercase tracking-widest px-2 py-0.5">
                  Recomendado
                </span>
              )}
            </div>
            <h3 class="text-xl md:text-2xl font-black uppercase tracking-tighter text-white mb-2">
              {pkg.name}
            </h3>
            <p class="text-white/45 text-sm leading-relaxed">{pkg.tagline}</p>
          </div>

          <ul class="flex flex-col gap-3 mb-8 flex-1">
            {pkg.features.map((feature) => (
              <li class="flex items-start gap-3 text-sm text-white/60 leading-snug">
                <svg class="w-3.5 h-3.5 text-brand-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {feature}
              </li>
            ))}
          </ul>

          {pkg.addon && (
            <p class="text-white/25 text-xs leading-relaxed mb-6 pl-3 border-l border-white/10">
              {pkg.addon}
            </p>
          )}

          <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4">
            <div>
              <p class="text-[10px] font-semibold uppercase tracking-widest text-white/25 mb-1">Desde</p>
              <p class="text-2xl md:text-3xl font-black text-white">
                {pkg.price}
                <span class="text-sm font-medium text-white/30 ml-1">+ IVA + pauta / mes</span>
              </p>
            </div>
            <a
              href="#contacto"
              class={`group inline-flex items-center gap-2 font-black uppercase text-xs tracking-widest px-5 py-3 transition-colors duration-200 flex-shrink-0 ${
                pkg.featured
                  ? 'bg-brand-accent text-black hover:bg-white'
                  : 'border border-white/20 text-white hover:border-brand-accent hover:text-brand-accent'
              }`}
            >
              Agendar asesoría
              <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-px bg-white/[0.02] p-8 md:p-10 flex flex-col sm:flex-row items-center justify-between gap-6">
      <p class="text-white/35 text-sm leading-relaxed max-w-xl">
        Si creemos que un paquete más sencillo puede ayudarte a cumplir tus objetivos, te lo diremos. Nuestro trabajo es ayudarte a tomar una buena decisión, no venderte el servicio más caro.
      </p>
      <a
        href="#contacto"
        class="group inline-flex items-center gap-3 border border-white/20 text-white hover:border-brand-accent hover:text-brand-accent font-black uppercase text-xs tracking-widest px-6 py-4 transition-colors duration-200 flex-shrink-0"
      >
        ¿No sabes cuál elegir? Hablemos.
        <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

  </div>
</section>

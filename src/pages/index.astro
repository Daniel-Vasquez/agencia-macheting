---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation";
import HeroCanvas from "../components/HeroCanvas";
import TeamPhoto from "../components/TeamPhoto.astro";
import PainPoints from "../components/PainPoints.astro";
import TrackTiles from "../components/TrackTiles.astro";
import MilestonesScroll from "../components/MilestonesScroll";
import PricingPackages from "../components/PricingPackages.astro";
import TeamStory from "../components/TeamStory.astro";
import Partnerships from "../components/Partnerships.astro";
import StoreSection from "../components/StoreSection.astro";
import Footer from "../components/Footer.astro";

const navLinks = [
  { label: "Servicios", href: "#servicios" },
  { label: "Proceso", href: "#proceso" },
  { label: "Paquetes", href: "#paquetes" },
  { label: "Contacto", href: "#contacto" },
];

const socialLinks = [
  { name: "Instagram", href: "#" },
  { name: "TikTok", href: "#" },
  { name: "YouTube", href: "#" },
  { name: "X", href: "#" },
];

const serviceTiles = [
  {
    id: "estrategia-redes",
    title: "Estrategia y Redes Sociales",
    subtitle:
      "Creamos contenido con intención, pensado para conectar con las personas correctas y construir una comunidad alrededor de tu marca.",
    image: "/images/dinamo.jpeg",
    href: "#paquetes",
  },
  {
    id: "branding",
    title: "Branding",
    subtitle:
      "Diseñamos identidades visuales que ayudan a que tu negocio sea recordado por lo que realmente es.",
    image: "/images/dinamo-2.jpeg",
    href: "#paquetes",
  },
  {
    id: "desarrollo-web",
    title: "Desarrollo Web",
    subtitle:
      "Creamos sitios web que transmiten confianza, funcionan correctamente y acompañan el crecimiento de tu empresa.",
    image: "/images/dinamo-5.jpeg",
    href: "#paquetes",
  },
  {
    id: "produccion-audiovisual",
    title: "Producción Audiovisual",
    subtitle:
      "Fotografía y video que muestran la esencia de tu negocio con naturalidad y profesionalismo.",
    image: "/images/dinamo-4.jpeg",
    href: "#paquetes",
  },
];

const trustedBrands = [{ name: "Fernando" }, { name: "Lulet" }];
---

<Layout
  title="Macheting | Agencia de Marketing para Pequeñas y Medianas Empresas"
  description="Más que un logotipo, tu negocio es el resultado de un gran esfuerzo. En Macheting trabajamos con pequeñas y medianas empresas que buscan crecer con estrategia, creatividad y personas que realmente se involucren en su proyecto."
>
  <Navigation client:load links={navLinks} socialLinks={socialLinks} />

  <main>
    <HeroCanvas client:load />

    <TeamPhoto />

    <PainPoints />

    <TrackTiles tiles={serviceTiles} />

    <MilestonesScroll client:visible />

    <PricingPackages />

    <TeamStory />

    <Partnerships partners={trustedBrands} />

    <StoreSection />
  </main>

  <Footer navLinks={navLinks} />
</Layout>
